model GitHubConnection {
  id                    Int      @id @default(autoincrement())
  userId                Int      @unique
  githubId              String   @unique
  username              String
  avatarUrl             String
  accessToken           String
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
