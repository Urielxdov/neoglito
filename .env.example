DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neoglito
ENCRYPTION_SECRET_KEY=replace-with-a-base64-encoded-32-byte-key

# Github authentication
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
BACKEND_URL=http://localhost:3000
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Autenticacion del backend
JWT_SECRET=una-clave-larga-y-aleatoria
FRONTEND_URL=http://localhost:5174
VITE_API_URL=http://localhost:3000

# Set to 0 only for local development behind a TLS-inspecting proxy.
NODE_TLS_REJECT_UNAUTHORIZED=1

# Telemetria (OpenTelemetry). Ver src/telemetry/infrastructure/collector/README.md
# Token con el que la API se identifica ante el receptor; sin el no hay telemetria propia.
TELEMETRY_SYSTEM_TOKEN=replace-with-a-long-random-token
# Collector visto desde la API (con la API en Docker: http://otel-collector:4318)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Collector visto desde los contenedores desplegados
TELEMETRY_DEPLOYMENT_COLLECTOR_ENDPOINT=http://host.docker.internal:4318
# Destino del collector. Con la API fuera de Docker: http://host.docker.internal:3000/telemetry/ingest
NEOGLITO_INGEST_URL=http://api:3000/telemetry/ingest
# false desactiva SDK, tokens e inyeccion
TELEMETRY_ENABLED=true
# false inyecta solo variables OTEL_*, sin agentes de lenguaje
TELEMETRY_AUTO_INSTRUMENTATION=true
TELEMETRY_RETENTION_DAYS=7
