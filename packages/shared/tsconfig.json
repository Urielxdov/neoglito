{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@neoglito/shared": ["src/index.ts"],
      "@neoglito/shared/*": ["src/*"]
    },
    "noEmit": true
  },
  "include": ["src"]
}
