model Repository {
  id            Int      @id @default(autoincrement())
  projectId     Int
  cloneUrl      String
  sshPrivateKey String
  technology    String?
  pathSystem    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project  @relation(fields: [projectId], references: [id])

  @@unique([projectId, cloneUrl])
}
